# Configuración de entorno local (copiar como .env solo si deseas usar PostgreSQL)
# Sin archivo .env el proyecto funciona inmediatamente con SQLite (db.sqlite3).

# Motor de base de datos: sqlite (por defecto) o postgresql
DB_ENGINE=sqlite

# Parámetros de PostgreSQL (solo si DB_ENGINE=postgresql)
# DB_NAME=cesfam_farmacia_db
# DB_USER=postgres
# DB_PASSWORD=tu_clave_local
# DB_HOST=localhost
# DB_PORT=5432

# Modo demostración abierta en /login/ (False por defecto: /simular-rol/ solo para Admin)
MODO_SIMULACION_DOCENTE=False
